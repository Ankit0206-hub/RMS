# Backend specific config
PROJECT_NAME="Restaurant ERP API"
SECRET_KEY="your_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Used by backend runtime AND db container)
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DB=dineops
MYSQL_USER=dineops_user
MYSQL_PASSWORD=dineops_pass
MYSQL_ROOT_PASSWORD=strong_root_password

# CORS Settings
# Ensure this matches exactly the URL of your frontend without a trailing slash
CORS_ORIGINS=http://localhost,http://localhost:80,https://rm.kvontech.com

# Frontend Configuration (Injected during build phase in compose if we passed them, but we're proxying)
# For this docker setup with Nginx reverse proxy, VITE_API_URL and VITE_WS_URL 
# should be relative or point back to the same host so the browser resolves it.
# We set them as relative paths, Nginx proxies /api to backend:8000
VITE_API_URL=/api/v1
VITE_WS_URL=/api/v1
